# Copy this file to ".env" and paste your own keys below.
# NEVER upload your real .env file to GitHub (it is already in .gitignore).

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Free token (type "Read" is fine): https://huggingface.co/settings/tokens
HF_API_KEY=your_huggingface_token_here

# ---- Optional settings (the defaults work fine) ----
# Gemini models to try, in order. If one hits its quota the next one is used.
# GEMINI_OUTLINE_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.8-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_STORY_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Image services to try for each panel, in order. If one fails or runs out of
# free quota, the next one is used.
# IMAGE_PROVIDERS=flux_space,huggingface,pollinations,horde

# Hugging Face image model (used by the "huggingface" service)
# HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers

# Number of panels per comic (1-10) and how many images to draw at once (1-6)
# NUM_PANELS=6
# IMAGE_WORKERS=3
